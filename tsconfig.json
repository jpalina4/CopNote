{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node's test runner (tests/*.mjs) loads .ts files directly, and Node
    // needs the real file extension in imports, e.g. './dates.ts'.
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts"]
}
