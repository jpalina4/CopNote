# Copy this file to .env and fill in real values. Never commit .env.
#
# CopNote does not call any remote service yet, so no variable is required
# today. These names are reserved for the planned backend; the values below
# are dummies.
#
# EXPO_PUBLIC_ values are inlined into the app at build time and are readable
# by anyone who has the APK. Only put publishable/anonymous keys here, never a
# service-role or admin key. For EAS cloud builds, also add each variable to
# the build profile in eas.json or with `eas env:create`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
